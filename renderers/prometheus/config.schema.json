  "required": [
    "version",
    "prometheus",
    "layout",
    "panels"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARPRT Prometheus configuration",
  "$defs": {
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "bearer",
                "basic"
              ]
            },
            "credentialsFile": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^/[^\\x00]+$"
            }
          },
          "required": [
            "type",
            "credentialsFile"
          ]
        },
        "scrapeInterval": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[1-9][0-9]*(s|m|h)$",
          "default": "60s"
        }
      },
      "required": []
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landscape": {
          "$ref": "#/$defs/grid"
        },
        "portrait": {
