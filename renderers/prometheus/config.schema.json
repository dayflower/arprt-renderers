{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "default": "Asia/Tokyo"
    },
    "prometheus": {
      "$ref": "#/$defs/prometheus"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      },
      "minItems": 1,
      "maxItems": 24
